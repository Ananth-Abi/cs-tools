# Port the public KB API listens on (default 8080). The webapp's example config
# expects 8085 for local development.
PORT=8085

# entity-service base URL. Required; published KB articles are read from here.
# Must be an absolute http(s) URL (a trailing slash is trimmed).
ENTITY_SERVICE_BASE_URL=http://localhost:8081

# OAuth2 client-credentials app this service authenticates to entity-service as.
# Same mechanism the other portal backends use. All three are required: this is a
# service identity, there is no end-user token on this public API.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
# Optional, comma-separated.
# ENTITY_SERVICE_SCOPES=

# Request timeouts (Go durations, e.g. 10s, 1m). Optional; all must be > 0.
# Keep ENTITY_SERVICE_TIMEOUT shorter than REST_WRITE_TIMEOUT so a clean error
# can be returned when entity-service is slow.
# REST_READ_TIMEOUT=10s
# REST_WRITE_TIMEOUT=30s
# ENTITY_SERVICE_TIMEOUT=10s

# Related-article semantic search. Optional: set BOTH or neither. Without them,
# related articles fall back to other published articles in the same knowledge base.
# PINECONE_HOST=https://example-index.svc.example.pinecone.io
# PINECONE_KEY=
